# Copie este arquivo para ".env.local" (uso local) e/ou configure estas
# variáveis no painel da Vercel (Project Settings → Environment Variables).
# NUNCA suba o .env.local ou a chave secreta para o GitHub.

# Chave SECRETA do Stripe (começa com sk_). Usada só no servidor (api/create-payment-intent.js).
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Signing secret do webhook (começa com whsec_). Você pega esse valor no
# painel do Stripe DEPOIS de criar o endpoint do webhook (veja README.md).
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx
